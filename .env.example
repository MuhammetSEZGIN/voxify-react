# Voxify web uygulaması — ortam değişkenleri
#
# VITE_ ile başlayan TÜM değerler build sırasında tarayıcı paketine GÖMÜLÜR
# ve son kullanıcı tarafından okunabilir. Bu değişkenlere parola, private key,
# access/refresh token veya sunucu sırrı koymayın.
#
# Üretim derlemesi için "Üretim" bölümüne bakın.

VITE_BASE_URL=http://localhost:5000
VITE_HUB_URL=http://localhost:5000/messagehub
VITE_PRESENCE_HUB_URL=http://localhost:5241/hubs/presence
VITE_LIVEKIT_URL=ws://localhost:7880
VITE_VOICE_SERVER_URL=http://localhost:5000

# Üçüncü taraf anahtarlar (ortamdan bağımsız)
VITE_TENOR_API_KEY=
VITE_TENOR_CLIENT_KEY=
VITE_IMGBB_KEY=
# Landing sayfasındaki Windows indirme düğmesi için doğrudan HTTPS paket adresi
VITE_VERSION_LINK=
