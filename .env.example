# Voxify masaüstü uygulaması — ortam değişkenleri
#
# Bu değerler build sırasında pakete GÖMÜLÜR. Sunucu adresi değiştiğinde
# .env'i güncellemek yetmez; yeni bir sürüm derlenip yayınlanması gerekir.
#
# Aşağıdaki değerler yerel geliştirme içindir (./run-local.sh).
# Üretim derlemesi için "Üretim" bölümüne bakın.

VITE_BASE_URL=http://localhost:5000
VITE_HUB_URL=http://localhost:5000/messagehub
VITE_PRESENCE_HUB_URL=http://localhost:5241/hubs/presence
VITE_LIVEKIT_URL=ws://localhost:7880
VITE_VOICE_SERVER_URL=http://localhost:5000

# Üçüncü taraf anahtarlar (ortamdan bağımsız)
VITE_TENOR_API_KEY=
VITE_TENOR_CLIENT_KEY=
VITE_IMGBB_KEY=
VITE_VERSION_LINK=

# ── Üretim ──
# API artık app.voxify.com.tr üzerinden yayınlanıyor; kök domain
# (voxify.com.tr) web uygulaması içindir. Üretim derlemesinde:
#
#   VITE_BASE_URL=https://app.voxify.com.tr
#   VITE_HUB_URL=https://app.voxify.com.tr/messagehub
#   VITE_PRESENCE_HUB_URL=https://app.voxify.com.tr/hubs/presence
#   VITE_LIVEKIT_URL=wss://app.voxify.com.tr/livekit
#   VITE_VOICE_SERVER_URL=https://app.voxify.com.tr
#   VITE_MOCKING=false
#
# Tauri updater endpoint'i .env'den değil src-tauri/tauri.conf.json'dan
# okunur; o da app. adresine güncellendi.

# ── Ayarlanmasına gerek olmayanlar ──
# VITE_NOTIFICATION_HUB_URL — tanımlanmazsa VITE_BASE_URL'den türetilir
#                             (bkz. src/utils/hubUrl.js), yani app. adresini
#                             otomatik alır.
# VITE_IDENTITY_URL         — yalnızca MSW mock'larında kullanılır.
# VITE_MOCKING              — yalnızca mock modunda "true" yapılır.
