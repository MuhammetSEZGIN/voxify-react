{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Voxify",
  "version": "1.4.1",
  "identifier": "com.voxify.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voxify",
        "width": 1000,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyNDJEQTAzMDlDREU4ODEKUldTQjZNMEpBOXBDUXNjbTdyck1TbUtOT2tob01WWlUxLy90VnQ4Wi94aU5DRno0bEVuaG1SOG4K",
      "endpoints": [
        "https://app.voxify.com.tr/update/{{target}}-{{arch}}/{{current_version}}"
      ]
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
